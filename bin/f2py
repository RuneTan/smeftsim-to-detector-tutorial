#!/usr/bin/env python3
"""Pass MadGraph 2.9 Fortran paths to NumPy's Python 3.12 Meson backend."""
import os
import shlex
import subprocess
import sys
from pathlib import Path

arguments = []
env = os.environ.copy()
for arg in sys.argv[1:]:
    if arg.startswith('--f77exec='):
        env['FC'] = arg.split('=', 1)[1]
    elif arg.startswith(('-I', '-L')) and len(arg) > 2:
        arguments.append(arg[:2] + str(Path(arg[2:]).resolve()))
    else:
        arguments.append(arg)
flags = f'-I{shlex.quote(str(Path.cwd()))} -ffixed-line-length-none -fallow-argument-mismatch'
env['FFLAGS'] = ' '.join([env.get('FFLAGS', ''), flags]).strip()
raise SystemExit(subprocess.call([sys.executable, '-m', 'numpy.f2py', *arguments], env=env))
